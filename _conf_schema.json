{
  "use_astrbot_config": {
    "description": "启用面板配置，并只应用下方明确选择的配置组",
    "type": "bool",
    "default": false
  },
  "apply_sections": {
    "description": "要应用的配置组名称列表；留空不修改旧配置，选中组的全部面板值会覆盖原值",
    "type": "list",
    "default": []
  },
  "api": {
    "description": "API连接设置",
    "type": "object",
    "items": {
      "unified_api_key": {
        "description": "统一API密钥",
        "type": "string",
        "default": "",
        "secret": true
      },
      "max_retries": {
        "description": "最大重试次数",
        "type": "int",
        "default": 3
      },
      "fallback_retries": {
        "description": "回退重试次数",
        "type": "int",
        "default": 2
      },
      "unified_base_url": {
        "description": "统一API基础地址",
        "type": "string",
        "default": ""
      },
      "model_brain": {
        "description": "核心推理模型",
        "type": "string",
        "default": ""
      },
      "model_vision": {
        "description": "视觉模型",
        "type": "string",
        "default": ""
      }
    }
  },
  "fallback_models": {
    "description": "降级模型选择",
    "type": "object",
    "items": {
      "chat": {
        "description": "对话模型",
        "type": "string",
        "default": ""
      },
      "vision": {
        "description": "视觉模型",
        "type": "string",
        "default": ""
      }
    }
  },
  "fallback_provider": {
    "description": "跨API服务商降级设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用降级提供商",
        "type": "bool",
        "default": false
      },
      "name": {
        "description": "提供商名称",
        "type": "string",
        "default": "备用API"
      },
      "api_key": {
        "description": "API密钥",
        "type": "string",
        "default": "",
        "secret": true
      },
      "base_url": {
        "description": "基础地址",
        "type": "string",
        "default": ""
      },
      "models": {
        "description": "模型配置",
        "type": "object",
        "items": {
          "chat": {
            "description": "对话模型",
            "type": "string",
            "default": ""
          },
          "vision": {
            "description": "视觉模型",
            "type": "string",
            "default": ""
          }
        }
      }
    }
  },
  "video": {
    "description": "视频处理设置",
    "type": "object",
    "items": {
      "browse_mode": {
        "description": "浏览模式",
        "type": "string",
        "default": "candidate_review"
      },
      "frame_note_mode": {
        "description": "帧笔记模式",
        "type": "string",
        "default": "visual_note"
      },
      "candidate_pool_size": {
        "description": "候选池大小",
        "type": "int",
        "default": 20
      },
      "visual_note_frame_interval": {
        "description": "视觉笔记帧间隔",
        "type": "int",
        "default": 6
      },
      "visual_note_max_frames": {
        "description": "视觉笔记最大帧数",
        "type": "int",
        "default": 240
      },
      "visual_note_grid_cols": {
        "description": "视觉笔记网格列数",
        "type": "int",
        "default": 3
      },
      "visual_note_grid_rows": {
        "description": "视觉笔记网格行数",
        "type": "int",
        "default": 3
      }
    }
  },
  "prompt_injection": {
    "description": "提示注入设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用提示注入",
        "type": "bool",
        "default": true
      },
      "custom_terms": {
        "description": "自定义术语",
        "type": "list",
        "default": [
          "system",
          "system prompt",
          "developer message",
          "提示词",
          "系统提示",
          "忽略之前指令",
          "越狱",
          "jailbreak",
          "开发者模式",
          "管理模式",
          "超级用户",
          "超级管理员",
          "管理员",
          "切换模式",
          "内部设定"
        ]
      }
    }
  },
  "vision": {
    "description": "视觉功能设置",
    "type": "object",
    "items": {
      "multimodal_enabled": {
        "description": "启用多模态",
        "type": "bool",
        "default": false
      },
      "cover_enabled": {
        "description": "启用封面分析",
        "type": "bool",
        "default": true
      },
      "frames_enabled": {
        "description": "启用帧分析",
        "type": "bool",
        "default": true
      },
      "analyze_frames_with_sufficient_subtitles": {
        "description": "字幕充足时分析帧",
        "type": "bool",
        "default": false
      }
    }
  },
  "approval_review": {
    "description": "审批复核设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用审批复核",
        "type": "bool",
        "default": true
      },
      "action_types": {
        "description": "需要审批的操作类型",
        "type": "object",
        "items": {
          "video_like": {
            "description": "视频点赞",
            "type": "bool",
            "default": true
          },
          "follow_up": {
            "description": "关注UP主",
            "type": "bool",
            "default": true
          },
          "send_danmaku": {
            "description": "发送弹幕",
            "type": "bool",
            "default": true
          },
          "private_reply": {
            "description": "私信回复",
            "type": "bool",
            "default": true
          },
          "coin": {
            "description": "投币",
            "type": "bool",
            "default": true
          },
          "favorite": {
            "description": "收藏",
            "type": "bool",
            "default": true
          }
        }
      }
    }
  },
